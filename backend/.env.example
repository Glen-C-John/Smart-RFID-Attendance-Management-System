# Server Configuration
PORT=5001
# Set to 'production' in production deployments to enable strict security headers and suppress verbose errors
NODE_ENV=development

# Database Connection
# Development: mongodb://127.0.0.1:27017/rfid_attendance
# Production: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/rfid_attendance?retryWrites=true&w=majority&tls=true
MONGODB_URI=mongodb://localhost:27017/rfid_attendance

# Timezone (Default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Authentication Keys & Admin Credentials
# Production: Generate with `openssl rand -hex 32`
ADMIN_API_KEY=admin_super_secret_key_change_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Production: Generate with `openssl rand -base64 64`
JWT_SECRET=super_secret_jwt_key_rfid_attendance_2026

# IoT Scanner Node Credentials (Must match firmware secrets.h)
DEFAULT_DEVICE_ID=ESP8266_001
DEFAULT_DEVICE_KEY=esp8266_device_secret_token_123

# Production HTTPS / Reverse Proxy Configuration:
# Route production traffic through an HTTPS reverse proxy (e.g. Nginx, Caddy, or Cloudflare SSL termination)
# Backend scan endpoint: https://<your-domain>/api/v1/device/scan

# Attendance Business Rules
ATTENDANCE_COOLDOWN_SECONDS=60
CHECKOUT_MIN_INTERVAL_MINUTES=5
WORK_DAY_START_TIME=09:00
LATE_THRESHOLD_TIME=09:30
ENABLE_CHECKOUT=true
DEVICE_HEARTBEAT_THRESHOLD_SECONDS=180
