{
  "name": "rfid-attendance-backend",
  "version": "1.0.0",
  "description": "Smart RFID Attendance Management System Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:start": "mkdir -p data/db && (mongod --dbpath data/db --bind_ip 127.0.0.1 --port 27017 --fork --logpath data/db/mongod.log 2>/dev/null || $HOME/.cache/mongodb-binaries/mongod* --dbpath data/db --bind_ip 127.0.0.1 --port 27017 --fork --logpath data/db/mongod.log)",
    "db:stop": "(mongod --dbpath data/db --shutdown 2>/dev/null || $HOME/.cache/mongodb-binaries/mongod* --dbpath data/db --shutdown) 2>/dev/null || true",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --detectOpenHandles --forceExit",
    "migrate": "node src/scripts/migrateGoogleSheets.js",
    "seed": "node src/scripts/seedData.js",
    "backup": "node src/scripts/backupDatabase.js",
    "restore": "node src/scripts/restoreDatabase.js"
  },
  "keywords": [
    "rfid",
    "esp8266",
    "attendance",
    "iot",
    "mfrc522",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  }
}
